# ====================================================================
# linux-sysadmin-labs - Lab Portfolio - .gitignore
# ====================================================================

# 1. Hypervisor & Virtualization Files (CRITICAL - DO NOT TRACK)
# --------------------------------------------------------------------
# VirtualBox files
*.vdi
*.vvfat
*.vmdk
*.vpc
*.vhd
*.vbox
*.vbox-prev
/vbox/
/.vbox/

# VMware files
*.vmwarevm
*.vmx
*.vmxf
*.vmdk
*.vmsd
*.vmsn
*.vmss
*.vmem
*.log
*.nvram

# Vagrant (if used later for VM automation)
.vagrant/

# 2. Operating System Artifacts
# --------------------------------------------------------------------
# Windows host artifacts
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS host artifacts (if applicable)
.DS_Store
.AppleDouble
.LSOverride

# 3. Text Editors & IDEs
# --------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.project
.settings/

# 4. Sensitive Data & Security (Accidental Leaks)
# --------------------------------------------------------------------
# Never commit your actual private keys, passwords, or AWS secret keys
*.pem
*.key
*.pub
.env
secret.txt
credentials.conf
